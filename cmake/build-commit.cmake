# arc_os — write the kernel's build commit into a C file (M1-04c).
#
# Run as `cmake -DSOURCE_DIR=<repo> -DOUT=<file.c> -P build-commit.cmake` on
# every build (a custom target in kernel/CMakeLists.txt). The file is rewritten
# only when the commit changes, so an unchanged tree recompiles nothing.
#
# The commit is `git describe --always --dirty --abbrev=12 --exclude=*`: the
# commit hash, plus "-dirty" when tracked files differ from it. --exclude=*
# keeps tag names out, so the boot report and every QR page header always name
# a commit. Outside a git checkout (an unpacked source archive) it is "unknown".

execute_process(
    COMMAND git describe --always --dirty --abbrev=12 --exclude=*
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET
    RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR commit STREQUAL "")
    set(commit "unknown")
endif()

set(text "/* Generated by cmake/build-commit.cmake: do not edit. */\n")
string(APPEND text "#include \"lib/build_commit.h\"\n\n")
string(APPEND text "const char arc_build_commit[] = \"${commit}\";\n")

if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
else()
    set(old "")
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
