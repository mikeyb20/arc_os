{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mikeyb20/arc_os/schemas/arcpkg.schema.json",
  "title": "arc_os .arcpkg manifest",
  "description": "manifest.json, the first member of every <name>-<version>.arcpkg (ADR-0010). One format for programs, models and knowledge packs; kind-specific fields sit in a `model` (model.schema.json) or `pack` (pack.schema.json) object whose name and version equal the package's.",
  "type": "object",
  "required": ["schema_version", "kind", "name", "version", "arch", "requires", "install_root",
               "license", "source", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["program", "model", "pack"] },
    "name": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "description": { "type": "string" },
    "arch": {
      "description": "CPU architecture of the contents; `any` for data (models, packs).",
      "enum": ["x86_64", "any"]
    },
    "cpu_level": {
      "description": "Lowest x86-64 microarchitecture level the contents need (programs built for v3 need AVX2).",
      "enum": ["x86-64", "x86-64-v2", "x86-64-v3", "x86-64-v4"]
    },
    "requires": {
      "type": "object",
      "required": ["ram_mb", "disk_bytes"],
      "properties": {
        "ram_mb": { "description": "RAM needed to use the package, in MiB.", "type": "integer", "minimum": 0 },
        "disk_bytes": { "description": "Disk space once installed.", "type": "integer", "minimum": 0 },
        "cpu_features": {
          "description": "CPU features needed beyond cpu_level, as /proc/cpuinfo flags (e.g. avx512f).",
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "packages": {
          "description": "Other packages that must be installed first (large packs split into several .arcpkg files depend on each other).",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/id" },
              "min_version": { "$ref": "common.schema.json#/$defs/semver" }
            }
          }
        }
      }
    },
    "install_root": {
      "description": "Directory the files/ payload is installed into (ADR-0009): /apps, /models or /packs, usually /<root>/<name>. /system is the OS image's, never a package's.",
      "type": "string",
      "pattern": "^/(apps|models|packs)(/[a-z0-9][a-z0-9-]*)*$"
    },
    "license": { "$ref": "common.schema.json#/$defs/license" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "files": {
      "description": "Every file of the payload: path under files/ (and under install_root once installed), size in bytes and SHA-256. Install verifies every hash before renaming into place.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/relpath" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "provides": {
      "description": "Commands or capabilities the package offers (e.g. the program names it installs).",
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "model": { "$ref": "model.schema.json" },
    "pack": { "$ref": "pack.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "program" } } },
      "then": {
        "properties": { "arch": { "const": "x86_64" }, "install_root": { "pattern": "^/apps(/|$)" } },
        "required": ["cpu_level"],
        "not": { "anyOf": [{ "required": ["model"] }, { "required": ["pack"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "model" } } },
      "then": {
        "properties": { "arch": { "const": "any" }, "install_root": { "pattern": "^/models(/|$)" } },
        "required": ["model"],
        "not": { "required": ["pack"] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "pack" } } },
      "then": {
        "properties": { "arch": { "const": "any" }, "install_root": { "pattern": "^/packs(/|$)" } },
        "required": ["pack"],
        "not": { "required": ["model"] }
      }
    }
  ]
}
